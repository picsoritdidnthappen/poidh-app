generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "251d0ac6-3e09-4fe2-929b-c4f5adc55390"]
}

model Bounties {
  id               Int
  chain_id         Int
  title            String
  description      String
  amount           String
  amount_sort      Float
  issuer           String
  in_progress      Boolean? @default(true)
  is_joined_bounty Boolean? @default(false)
  is_canceled      Boolean? @default(false)
  is_multiplayer   Boolean?
  is_voting        Boolean? @default(false)
  deadline         Int?

  claims         Claims[]
  participations ParticipationsBounties[]
  issuerUser     Users?                   @relation(fields: [issuer], references: [address])
  ban            Ban[]
  transactions   Transactions[]

  @@id([id, chain_id])
  @@schema("f5c72623-8a40-4503-b1a8-5b749dddeaf5")
}

model Claims {
  id          Int
  chain_id    Int
  title       String
  description String
  url         String
  issuer      String
  is_accepted Boolean?
  bounty_id   Int
  owner       String

  bounty     Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  issuerUser Users?    @relation(fields: [issuer], references: [address])
  ban        Ban[]

  @@id([id, chain_id])
  @@schema("f5c72623-8a40-4503-b1a8-5b749dddeaf5")
}

model ParticipationsBounties {
  user_address String
  bounty_id    Int
  chain_id     Int
  amount       String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  user   Users?    @relation(fields: [user_address], references: [address])

  @@id([user_address, bounty_id, chain_id])
  @@schema("f5c72623-8a40-4503-b1a8-5b749dddeaf5")
}

model Users {
  address   String
  twitter   String?
  farcaster String?

  participations ParticipationsBounties[]
  claims         Claims[]
  bounties       Bounties[]

  @@id([address])
  @@schema("f5c72623-8a40-4503-b1a8-5b749dddeaf5")
}

model Ban {
  id        Int      @id @default(autoincrement())
  chain_id  Int
  bounty_id Int?
  claim_id  Int?
  banned_at DateTime @default(now())
  banned_by String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  claim  Claims?   @relation(fields: [claim_id, chain_id], references: [id, chain_id])

  @@schema("public")
}

model Transactions {
  tx        String
  index     Int
  bounty_id Int
  chain_id  Int
  address   String
  action    String
  timestamp Decimal @db.Decimal(78, 0)

  bounty Bounties @relation(fields: [bounty_id, chain_id], references: [id, chain_id])

  @@id([tx, index, chain_id])
  @@schema("f5c72623-8a40-4503-b1a8-5b749dddeaf5")
}
