generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // We are using Prisma 5, but the latest Prisma LSP targets version 7
  // You can safely ignore this warning, or upgrade to Prisma 7 :)
  url      = env("DATABASE_URL")
}

model Bounties {
  id               Int
  chain_id         Int
  title            String
  description      String
  amount           String
  amount_sort      Float
  issuer           String
  created_at       Decimal  @db.Decimal(78, 0)
  in_progress      Boolean? @default(true)
  is_joined_bounty Boolean? @default(false)
  is_canceled      Boolean? @default(false)
  is_multiplayer   Boolean?
  is_voting        Boolean? @default(false)
  deadline         Int?

  claims         Claims[]
  participations ParticipationsBounties[]
  issuerUser     Users?                   @relation(fields: [issuer], references: [address])
  ban            Ban[]
  transactions   Transactions[]
  comments       Comments[]

  @@id([id, chain_id])
}

model BountiesExtra {
  bounty_id Int
  chain_id  Int
  album     String

  @@id([bounty_id, chain_id])
}

model Claims {
  id          Int
  chain_id    Int
  title       String
  description String
  url         String
  issuer      String
  is_accepted Boolean?
  bounty_id   Int
  owner       String

  bounty       Bounties?      @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  issuerUser   Users?         @relation(fields: [issuer], references: [address])
  ban          Ban[]
  transactions Transactions[]

  @@id([id, chain_id])
}

model ParticipationsBounties {
  user_address String
  bounty_id    Int
  chain_id     Int
  amount       String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  user   Users?    @relation(fields: [user_address], references: [address])

  @@id([user_address, bounty_id, chain_id])
}

model Users {
  address String

  participations ParticipationsBounties[]
  claims         Claims[]
  bounties       Bounties[]
  comments       Comments[]
  usersExtras    UsersExtra[]

  @@id([address])
}

model UsersExtra {
  address       String
  pfp_url       String?
  ens           String?
  degen_name    String?
  farcaster_tag String?
  twitter_tag   String?
  last_updated  DateTime @default(now())

  user Users @relation(fields: [address], references: [address])

  @@id([address])
}

model Ban {
  id        Int      @id @default(autoincrement())
  chain_id  Int
  bounty_id Int?
  claim_id  Int?
  banned_at DateTime @default(now())
  banned_by String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  claim  Claims?   @relation(fields: [claim_id, chain_id], references: [id, chain_id])
}

model Transactions {
  tx        String
  index     Int
  bounty_id Int
  claim_id  Int?
  chain_id  Int
  address   String
  action    String
  timestamp Decimal @db.Decimal(78, 0)

  bounty Bounties @relation(fields: [bounty_id, chain_id], references: [id, chain_id])
  claim  Claims?  @relation(fields: [claim_id, chain_id], references: [id, chain_id])

  @@id([tx, index, chain_id])
}

model Leaderboard {
  address  String
  chain_id Int
  earned   Float  @default(0)
  paid     Float  @default(0)
  nfts     Float  @default(0)

  @@id([address, chain_id])
}

model Price {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  degen_usd  Decimal?
  eth_usd    Decimal?
}

model Comments {
  id           Int       @id @default(autoincrement())
  bounty_id    Int
  chain_id     Int
  parent_id    Int?
  user_address String
  body         String
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  bounty    Bounties    @relation(fields: [chain_id, bounty_id], references: [chain_id, id], onDelete: NoAction)
  author    Users?      @relation(fields: [user_address], references: [address], onDelete: NoAction)
  parent    Comments?   @relation("CommentToParent", fields: [parent_id], references: [id], onDelete: NoAction)
  replies   Comments[]  @relation("CommentToParent")
  reactions Reactions[]

  @@index([bounty_id])
  @@index([chain_id])
  @@index([parent_id])
  @@index([user_address])
}

model Reactions {
  id         Int      @id @default(autoincrement())
  comment_id Int
  type       Reaction

  comment Comments @relation(fields: [comment_id], references: [id])
}

enum Reaction {
  upvote
  downvote
}
