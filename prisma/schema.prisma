generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bounties {
  id             Int
  onChainId      Int      @map("on_chain_id")
  chainId        Int      @map("chain_id")
  title          String
  description    String
  amount         String
  amountSort     Float    @map("amount_sort")
  issuer         String
  createdAt      Decimal  @map("created_at") @db.Decimal(78, 0)
  inProgress     Boolean? @default(true) @map("in_progress")
  isJoinedBounty Boolean? @default(false) @map("is_joined_bounty")
  isCanceled     Boolean? @default(false) @map("is_canceled")
  isMultiplayer  Boolean? @map("is_multiplayer")
  isVoting       Boolean? @default(false) @map("is_voting")
  deadline       Int?

  claims         Claims[]
  participations ParticipationsBounties[]
  issuerUser     Users?                   @relation(fields: [issuer], references: [address])
  ban            Ban[]
  transactions   Transactions[]
  comments       Comments[]
  votes          Votes[]

  @@id([id, chainId])
}

model BountiesExtra {
  bountyId Int @map("bounty_id")
  chainId  Int @map("chain_id")
  album    String

  @@id([bountyId, chainId])
}

model Claims {
  id          Int
  onChainId   Int      @map("on_chain_id")
  chain_id    Int
  title       String
  description String
  url         String
  issuer      String
  is_accepted Boolean?
  bounty_id   Int
  owner       String

  bounty       Bounties?      @relation(fields: [bounty_id, chain_id], references: [id, chainId])
  issuerUser   Users?         @relation(fields: [issuer], references: [address])
  ban          Ban[]
  transactions Transactions[]

  @@id([id, chain_id])
}

model ParticipationsBounties {
  user_address String
  bounty_id    Int
  chain_id     Int
  amount       String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chainId])
  user   Users?    @relation(fields: [user_address], references: [address])

  @@id([user_address, bounty_id, chain_id])
}

model Users {
  address            String
  withdrawalDegen    Int    @default(0) @map("withdrawal_amount_degen")
  withdrawalBase     Int    @default(0) @map("withdrawal_amount_base")
  withdrawalArbitrum Int    @default(0) @map("withdrawal_amount_arbitrum")

  participations ParticipationsBounties[]
  claims         Claims[]
  bounties       Bounties[]
  comments       Comments[]
  usersExtras    UsersExtra[]
  reactions      Reactions[]

  @@id([address])
}

model UsersExtra {
  address       String
  pfp_url       String?
  ens           String?
  degen_name    String?
  farcaster_tag String?
  twitter_tag   String?
  last_updated  DateTime @default(now())

  user Users @relation(fields: [address], references: [address])

  @@id([address])
}

model Ban {
  id        Int      @id @default(autoincrement())
  chain_id  Int
  bounty_id Int?
  claim_id  Int?
  banned_at DateTime @default(now())
  banned_by String

  bounty Bounties? @relation(fields: [bounty_id, chain_id], references: [id, chainId])
  claim  Claims?   @relation(fields: [claim_id, chain_id], references: [id, chain_id])
}

model Transactions {
  tx        String
  index     Int
  bounty_id Int
  claim_id  Int?
  chain_id  Int
  address   String
  action    String
  timestamp Decimal @db.Decimal(78, 0)

  bounty Bounties @relation(fields: [bounty_id, chain_id], references: [id, chainId])
  claim  Claims?  @relation(fields: [claim_id, chain_id], references: [id, chain_id])

  @@id([tx, index, chain_id])
}

model Leaderboard {
  address  String
  chain_id Int
  earned   Float  @default(0)
  paid     Float  @default(0)
  nfts     Float  @default(0)

  @@id([address, chain_id])
}

model Price {
  id         Int      @id @default(autoincrement())
  created_at DateTime @default(now())
  degen_usd  Decimal?
  eth_usd    Decimal?
}

model Comments {
  id           Int       @id @default(autoincrement())
  bounty_id    Int
  chain_id     Int
  parent_id    Int?
  user_address String
  body         String
  created_at   DateTime  @default(now())
  deleted_at   DateTime?

  bounty    Bounties    @relation(fields: [chain_id, bounty_id], references: [chainId, id], onDelete: NoAction)
  author    Users?      @relation(fields: [user_address], references: [address], onDelete: NoAction)
  parent    Comments?   @relation("CommentToParent", fields: [parent_id], references: [id], onDelete: NoAction)
  replies   Comments[]  @relation("CommentToParent")
  reactions Reactions[]

  @@index([bounty_id])
  @@index([chain_id])
  @@index([parent_id])
  @@index([user_address])
}

model Votes {
  chainId  Int @map("chain_id")
  bountyId Int @map("bounty_id")
  claimId  Int @map("claim_id")
  yes      Int
  no       Int
  round    Int

  bounty Bounties @relation(fields: [bountyId, chainId], references: [id, chainId])

  @@id([bountyId, chainId, round])
}

model Reactions {
  id         Int      @id @default(autoincrement())
  comment_id Int
  type       Reaction
  address    String

  comment Comments @relation(fields: [comment_id], references: [id])
  user    Users    @relation(fields: [address], references: [address])
}

enum Reaction {
  upvote
  downvote
}
