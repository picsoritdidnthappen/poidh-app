generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Bounties {
  id             Int
  onChainId      Int     @map("on_chain_id")
  chainId        Int     @map("chain_id")
  title          String
  description    String
  amount         String
  issuer         String
  createdAt      Decimal @map("created_at") @db.Decimal(78, 0)
  inProgress     Boolean @default(true) @map("in_progress")
  isJoinedBounty Boolean @default(false) @map("is_joined_bounty")
  isCanceled     Boolean @default(false) @map("is_canceled")
  isMultiplayer  Boolean @default(false) @map("is_multiplayer")
  isVoting       Boolean @default(false) @map("is_voting")
  deadline       Int?

  claims         Claims[]
  participations ParticipationsBounties[]
  issuerUser     Users                    @relation(fields: [issuer], references: [address])
  ban            Ban[]
  transactions   Transactions[]
  comments       Comments[]
  votes          Votes[]
  extra          BountiesExtra            @relation(fields: [id, chainId], references: [bountyId, chainId])

  @@id([id, chainId])
}

model BountiesExtra {
  bountyId   Int    @map("bounty_id")
  chainId    Int    @map("chain_id")
  album      String
  amountSort Float  @map("amount_sort")

  bounty Bounties?

  @@id([bountyId, chainId])
}

model Claims {
  id          Int
  onChainId   Int     @map("on_chain_id")
  chainId     Int     @map("chain_id")
  title       String
  description String
  url         String
  issuer      String
  isAccepted  Boolean @default(false) @map("is_accepted")
  bountyId    Int     @map("bounty_id")
  owner       String

  bounty       Bounties       @relation(fields: [bountyId, chainId], references: [id, chainId])
  issuerUser   Users          @relation(fields: [issuer], references: [address])
  ban          Ban[]
  transactions Transactions[]

  @@id([id, chainId])
}

model ParticipationsBounties {
  userAddress String @map("user_address")
  bountyId    Int    @map("bounty_id")
  chainId     Int    @map("chain_id")
  amount      String

  bounty Bounties @relation(fields: [bountyId, chainId], references: [id, chainId])
  user   Users    @relation(fields: [userAddress], references: [address])

  @@id([userAddress, bountyId, chainId])
}

model Users {
  address            String
  withdrawalDegen    Decimal @default(0) @map("withdrawal_amount_degen") @db.Decimal(20, 18)
  withdrawalBase     Decimal @default(0) @map("withdrawal_amount_base") @db.Decimal(20, 18)
  withdrawalArbitrum Decimal @default(0) @map("withdrawal_amount_arbitrum") @db.Decimal(20, 18)

  participations ParticipationsBounties[]
  claims         Claims[]
  bounties       Bounties[]
  comments       Comments[]
  usersExtras    UsersExtra[]
  reactions      Reactions[]

  @@id([address])
}

model UsersExtra {
  address      String
  pfpUrl       String?  @map("pfp_url")
  ens          String?
  degenName    String?  @map("degen_name")
  wei          String?
  farcasterTag       String?   @map("farcaster_tag")
  twitterTag         String?   @map("twitter_tag")
  zkpassportCountry  String?   @map("zkpassport_country")
  zkpassportVerifiedAt DateTime? @map("zkpassport_verified_at")
  lastUpdated        DateTime  @default(now()) @map("last_updated")

  user Users @relation(fields: [address], references: [address])

  @@id([address])
}

model Ban {
  id       Int      @id @default(autoincrement())
  chainId  Int      @map("chain_id")
  bountyId Int?     @map("bounty_id")
  claimId  Int?     @map("claim_id")
  bannedAt DateTime @default(now()) @map("banned_at")
  bannedBy String   @map("banned_by")

  bounty Bounties? @relation(fields: [bountyId, chainId], references: [id, chainId])
  claim  Claims?   @relation(fields: [claimId, chainId], references: [id, chainId])
}

model Transactions {
  tx        String
  index     Int
  bountyId  Int     @map("bounty_id")
  claimId   Int?    @map("claim_id")
  chainId   Int     @map("chain_id")
  address   String
  action    String
  timestamp Decimal @db.Decimal(78, 0)

  bounty Bounties @relation(fields: [bountyId, chainId], references: [id, chainId])
  claim  Claims?  @relation(fields: [claimId, chainId], references: [id, chainId])

  @@id([tx, index, chainId])
}

model Leaderboard {
  address String
  chainId Int    @map("chain_id")
  earned  Float  @default(0)
  paid    Float  @default(0)
  nfts    Float  @default(0)

  @@id([address, chainId])
}

model Price {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at")
  degenUsd  Decimal? @map("degen_usd")
  ethUsd    Decimal? @map("eth_usd")
}

model Comments {
  id          Int       @id @default(autoincrement())
  bountyId    Int       @map("bounty_id")
  chainId     Int       @map("chain_id")
  parentId    Int?      @map("parent_id")
  userAddress String    @map("user_address")
  body        String
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  bounty    Bounties    @relation(fields: [chainId, bountyId], references: [chainId, id], onDelete: NoAction)
  author    Users       @relation(fields: [userAddress], references: [address], onDelete: NoAction)
  parent    Comments?   @relation("CommentToParent", fields: [parentId], references: [id], onDelete: NoAction)
  replies   Comments[]  @relation("CommentToParent")
  reactions Reactions[]

  @@index([bountyId])
  @@index([chainId])
  @@index([parentId])
  @@index([userAddress])
}

model Votes {
  chainId  Int     @map("chain_id")
  bountyId Int     @map("bounty_id")
  claimId  Int     @map("claim_id")
  yes      Decimal
  no       Decimal
  round    Int

  bounty Bounties @relation(fields: [bountyId, chainId], references: [id, chainId])

  @@id([bountyId, chainId, round])
}

model Reactions {
  id        Int      @id @default(autoincrement())
  commentId Int      @map("comment_id")
  type      Reaction
  address   String

  comment Comments @relation(fields: [commentId], references: [id])
  user    Users    @relation(fields: [address], references: [address])
}

model Notifications {
  id        Int       @id @default(autoincrement())
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  event     String
  data      Json
  sendAt    DateTime? @map("send_at") @db.Timestamptz(6)

  @@map("Notifications")
}

enum Reaction {
  upvote
  downvote
}
